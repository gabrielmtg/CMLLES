#!/bin/sh
#
# BusyBox init.d autorun script for the VisionFive2/CMLLES image.
# (Buildroot's default init is BusyBox init, not systemd, so this replaces
# the RPi flow's cmlles-bench.service unit with the same start/logic split.)
#

case "$1" in
  start)
	echo "Running CMLLES Machine Learning Benchmarks..."
	sleep 5
	/usr/bin/cmlles_tests/run_benchmarks.sh
	;;
  stop)
	;;
  *)
	echo "Usage: $0 {start|stop}"
	exit 1
	;;
esac

exit 0
