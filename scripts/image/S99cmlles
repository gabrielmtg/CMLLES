#!/bin/sh
#
# Run CMLLES Tests on boot
#

case "$1" in
  start)
	echo "Running CMLLES Machine Learning Benchmarks..."
	
	# Wait a bit for system to settle
	sleep 5
	
	cd /usr/bin/cmlles_tests
	
	echo "--- FANN Tests ---"
	./fann_nsl || echo "fann_nsl failed"
	./fann_iaes || echo "fann_iaes failed"
	./fann_iris || echo "fann_iris failed"
	
	echo "--- NCNN Tests ---"
	./ncnn_nsl || echo "ncnn_nsl failed"
	./ncnn_cmapss || echo "ncnn_cmapss failed"
	./ncnn_vww || echo "ncnn_vww failed"
	./ncnn_iaes || echo "ncnn_iaes failed"
	./ncnn_iris || echo "ncnn_iris failed"
	
	echo "--- LiteRT Tests ---"
	./litert_nsl || echo "litert_nsl failed"
	./litert_cmapss || echo "litert_cmapss failed"
	./litert_vww || echo "litert_vww failed"
	./litert_iaes || echo "litert_iaes failed"
	./litert_iris || echo "litert_iris failed"
	
	echo "--- ONNX Tests ---"
	./onnx_nsl || echo "onnx_nsl failed"
	./onnx_cmapss || echo "onnx_cmapss failed"
	./onnx_vww || echo "onnx_vww failed"
	./onnx_iaes || echo "onnx_iaes failed"
	./onnx_iris || echo "onnx_iris failed"
	
	echo "Benchmarks Completed!"
	;;
  stop)
	;;
  *)
	echo "Usage: $0 {start|stop}"
	exit 1
esac

exit 0
